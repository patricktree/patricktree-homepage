{
  "name": "@patricktree-homepage/e2e-test",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "e2e-test": "playwright test --config ./src/playwright.config.ts",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:file": "eslint --max-warnings 0",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "pnpm run lint:file .",
    "turbo:lint:fix": "pnpm run lint:file . --fix"
  },
  "dependencies": {
    "@patricktree/fetch-sitemap-locations": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
