{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//", "@patricktree-stack/config-turbo-typescript"],
  "tasks": {
    "turbo:build": {
      "env": ["DEPLOYMENT_ORIGIN", "VERCEL_URL"],
      /* the apps type-check only (`noEmit`), so there is no `dist` to cache */
      "outputs": ["*.tsbuildinfo"],
    },
    "turbo:lint:fix": {
      "outputs": [
        "src/**",
        "!src/**/*.jpeg",
        "!src/**/*.jpg",
        "!src/**/*.png",
        "!src/**/*.svg",
        "!src/**/*.webp",
        "!src/**/*.gif",
      ],
    },
  },
}
