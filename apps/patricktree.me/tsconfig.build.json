{
  "extends": [
    "@patricktree-stack/config-typescript/tsconfig.defaults.json",
    "@patricktree-stack/config-typescript/tsconfig.node24.json",
    "@patricktree-stack/config-typescript/tsconfig.next.json"
  ],
  "compilerOptions": {
    /* Modules */
    "types": ["node", "@types/mdx"]
  },
  "include": [
    "next-env.d.ts",
    "next-env-custom.d.ts",
    "dist/types/**/*.ts",
    "src/**/*",
    "src/**/*.md",
    "src/**/*.mdx"
  ],
  "exclude": ["**/node_modules"]
}
