{
  "name": "@patricktree-homepage/patricktree.me",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*": "./src/*"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:next": "pnpm run clean && pnpm run internal:compile && generate-and-store-rss-feed && pnpm run internal:build:next && pnpm run internal:build:sitemap",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "next dev --webpack",
    "internal:build:next": "next build --webpack",
    "internal:build:sitemap": "next-sitemap --config next-sitemap.cjs",
    "internal:compile": "tsc --build ./tsconfig.json",
    "internal:compile:watch": "pnpm run internal:compile --watch",
    "internal:fetch-favicons": "playwright install chromium && pnpm run internal:compile && fetch-favicons-for-articles && oxfmt \"./generated/favicons-for-websites.json\" && git add \"./generated/favicons-for-websites.json\"",
    "internal:generate-css-modules": "pnpm run internal:compile && generate-css-modules-for-articles && oxfmt \"./src/app/**/*.module.css\" && git add \"./src/app/**/*.module.css\"",
    "lint": "turbo run turbo:lint",
    "lint:css": "stylelint \"./src/**/*.(css|ts|cts|mts|tsx|ctsx|mtsx)\" \"!./src/app/blog/*/styles.module.css\" \"!./src/app/projects/*/styles.module.css\" \"!./src/app/tidbits/*/styles.module.css\"",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "next start",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 . && pnpm run lint:css",
    "turbo:lint:fix": "oxlint --type-aware --max-warnings 0 . --fix && pnpm run lint:css --fix"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@giscus/react": "^3.1.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.0",
    "@patricktree-homepage/mdx": "workspace:*",
    "@patricktree-homepage/mdx-blog": "workspace:*",
    "@patricktree-homepage/ui-utils": "workspace:*",
    "@patricktree-stack/react-utils": "workspace:*",
    "@patricktree-stack/utils-ecma": "workspace:*",
    "@pigment-css/react": "^0.0.31",
    "@vercel/speed-insights": "^2.0.0",
    "acorn": "^8.19.0",
    "dayjs": "^1.11.23",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-feather": "^2.0.10",
    "sharp": "^0.35.5",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.10",
    "@opentelemetry/api": "^1.9.1",
    "@patricktree-homepage/config-oxlint": "workspace:*",
    "@patricktree-stack/config-nextjs": "workspace:*",
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@patricktree-stack/config-stylelint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@typescript/native": "catalog:",
    "@vercel/analytics": "^2.0.1",
    "next-sitemap": "^4.2.3",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "^1.64.0",
    "stylelint": "catalog:",
    "typescript": "catalog:"
  }
}
