{
  "name": "@patricktree-homepage/physio-kerschbaum.at",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*": "./src/*"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:next": "pnpm run clean && pnpm run internal:compile && pnpm run internal:build:next && pnpm run internal:build:sitemap",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "dev": "next dev",
    "internal:build:next": "next build",
    "internal:build:sitemap": "next-sitemap --config next-sitemap.cjs",
    "internal:compile": "tsc --build ./tsconfig.json",
    "internal:compile:watch": "pnpm run internal:compile --watch",
    "lint": "turbo run turbo:lint",
    "lint:css": "stylelint \"./src/**/*.(css|ts|cts|mts|tsx|ctsx|mtsx)\"",
    "lint:fix": "turbo run turbo:lint:fix",
    "start": "next start",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 . && pnpm run lint:css",
    "turbo:lint:fix": "oxlint --type-aware --max-warnings 0 . --fix && pnpm run lint:css --fix"
  },
  "dependencies": {
    "@patricktree-homepage/react-utils": "workspace:*",
    "@pigment-css/react": "^0.0.30",
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-feather": "^2.0.10",
    "sharp": "^0.34.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@pigment-css/nextjs-plugin": "^0.0.30",
    "@types/node": "catalog:",
    "@types/react": "^18",
    "@typescript/native": "catalog:",
    "@vercel/analytics": "^1.5.0",
    "next-sitemap": "^4.2.3",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "^8.5.3",
    "postcss-styled-syntax": "^0.7.1",
    "stylelint": "^16.19.1",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "catalog:"
  }
}
