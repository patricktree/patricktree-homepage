{
  "extends": [
    "@patricktree-stack/config-typescript/tsconfig.defaults.json",
    "@patricktree-stack/config-typescript/tsconfig.typescript-execution-via-type-stripping.json",
    "@patricktree-stack/config-typescript/tsconfig.emit-js-and-declarations.json"
  ],
  "compilerOptions": {
    /* Modules */
    "lib": ["dom", "dom.iterable", "es2019"],
    "target": "ES2019",
    "rootDir": "./src",

    /* Emit */
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
