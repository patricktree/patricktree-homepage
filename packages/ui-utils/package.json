{
  "name": "@patricktree-homepage/ui-utils",
  "private": true,
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
