{
  "name": "@patricktree-homepage/mdx-blog",
  "private": true,
  "bin": {
    "fetch-favicons-for-articles": "./bin/fetch-favicons-for-articles.js",
    "generate-and-store-rss-feed": "./bin/generate-and-store-rss-feed.js",
    "generate-css-modules-for-articles": "./bin/generate-css-modules-for-articles.js"
  },
  "type": "module",
  "imports": {
    "#pkg/*": "./dist/*"
  },
  "exports": {
    ".": null,
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "build:watch": "turbo watch turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "internal:compile": "tsc --build ./tsconfig.json",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "pnpm run internal:compile",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@patricktree-homepage/mdx": "workspace:*",
    "@patricktree/commons-ecma": "^2.4.1",
    "@patricktree/fetch-favicon": "^1.3.0",
    "feed": "^4.2.2",
    "gray-matter": "^4.0.3",
    "playwright": "^1.52.0",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@patricktree-stack/config-oxlint": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
